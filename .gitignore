# ==========================================
# HealthVault Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.cert
*.crt

# Production build outputs
.next/
**/.next/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
*.tsbuildinfo

# Runtime logs
*.log
**/*.log

# Medical files, PHI, storage & uploads
storage/
**/storage/
uploads/
**/uploads/

# Generated Prisma client
backend/src/generated/prisma/
**/backend/src/generated/prisma/

# Database dumps & local scratch SQL
*.sql
!**/migrations/**/*.sql
**/temp.sql

# Scratch scripts, temporary test runs, and logs
scratch/
test-results/
**/test-results/

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
