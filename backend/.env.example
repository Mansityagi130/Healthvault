PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=healthvault-auth
JWT_AUDIENCE=healthvault-users

# Email Delivery Configuration
# Supported modes: "smtp" (required for production/live delivery) | "ethereal" (development test inbox) | "test" (automated tests)
EMAIL_MODE=smtp
# For Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="HealthVault Security <your_email@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
