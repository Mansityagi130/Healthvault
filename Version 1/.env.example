# ==========================================
# HealthVault Environment Configuration Template
# ==========================================

# Port for Express API server (Internal only)
PORT=5000

# Node environment: development | production | test
NODE_ENV=production

# Base URL of frontend application for CORS policy alignment
FRONTEND_URL=http://localhost

# Database connection URL (RDS Postgres or container database name; use sslmode=verify-full for production SSL)
DATABASE_URL=postgresql://healthvault_user:secure_dev_db_password_123@postgres:5432/healthvault?schema=public&sslmode=verify-full

# Redis connection URL (ElastiCache Redis or container name)
REDIS_URL=redis://redis:6379

# Local storage path for medical documents
STORAGE_PATH=/app/storage

# Cryptographically strong secrets for session token generation (min 32 characters)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_at_least_32_chars_long

# AES-256-GCM symmetric encryption key for TOTP secrets-at-rest (min 32 characters)
MFA_ENCRYPTION_KEY=your_super_secret_mfa_encryption_key_at_least_32_chars_long
